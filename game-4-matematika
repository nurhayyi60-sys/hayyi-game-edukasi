<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>🎮 Math Adventure - Petualangan Matematika</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    font-family: 'Comic Sans MS', 'Segoe UI', cursive, sans-serif;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 25%, #f093fb 50%, #f5576c 75%, #ffd89b 100%);
    min-height: 100vh;
    overflow-x: hidden;
  }

  /* Animated clouds */
  .cloud {
    position: fixed;
    background: rgba(255, 255, 255, 0.8);
    border-radius: 100px;
    animation: floatCloud 30s infinite linear;
    z-index: 0;
  }
  .cloud:before, .cloud:after {
    content: '';
    position: absolute;
    background: rgba(255, 255, 255, 0.8);
    border-radius: 50%;
  }
  @keyframes floatCloud {
    from { transform: translateX(-200px); }
    to { transform: translateX(100vw); }
  }

  /* Floating elements */
  .floating-element {
    position: fixed;
    font-size: 2em;
    animation: floatUp 10s infinite;
    opacity: 0.6;
    z-index: 0;
    pointer-events: none;
  }
  @keyframes floatUp {
    0% { transform: translateY(100vh) rotate(0deg); opacity: 0; }
    10% { opacity: 0.6; }
    90% { opacity: 0.6; }
    100% { transform: translateY(-100px) rotate(360deg); opacity: 0; }
  }

  .container {
    max-width: 900px;
    margin: 0 auto;
    padding: 20px;
    position: relative;
    z-index: 1;
  }

  /* Header */
  .header {
    text-align: center;
    margin-bottom: 20px;
    animation: bounceIn 1s;
  }
  @keyframes bounceIn {
    0% { transform: scale(0); }
    50% { transform: scale(1.1); }
    70% { transform: scale(0.9); }
    100% { transform: scale(1); }
  }
  .header h1 {
    font-size: 3em;
    color: #fff;
    text-shadow: 4px 4px 0 #ff6b6b, 8px 8px 0 rgba(0,0,0,0.2);
    margin-bottom: 10px;
    letter-spacing: 2px;
  }
  .header p {
    font-size: 1.3em;
    color: #fff;
    text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
  }

  /* Stats bar */
  .stats-bar {
    display: flex;
    justify-content: space-around;
    background: linear-gradient(135deg, #fff 0%, #f0f0f0 100%);
    padding: 15px;
    border-radius: 25px;
    margin-bottom: 20px;
    box-shadow: 0 8px 20px rgba(0,0,0,0.2);
    border: 4px solid #FFD700;
  }
  .stat-item {
    text-align: center;
  }
  .stat-item .icon {
    font-size: 2em;
    margin-bottom: 5px;
  }
  .stat-item .label {
    font-size: 0.9em;
    color: #666;
    font-weight: bold;
  }
  .stat-item .value {
    font-size: 1.8em;
    font-weight: bold;
    color: #ff6b6b;
  }
  .stat-item .value.score { color: #4ecdc4; }
  .stat-item .value.level { color: #95e1d3; }
  .stat-item .value.timer { color: #f38181; }

  /* Timer bar */
  .timer-bar {
    width: 100%;
    height: 20px;
    background: rgba(255,255,255,0.3);
    border-radius: 10px;
    margin-bottom: 20px;
    overflow: hidden;
    border: 3px solid #fff;
  }
  .timer-fill {
    height: 100%;
    background: linear-gradient(90deg, #4ecdc4, #44a08d);
    width: 100%;
    transition: width 1s linear;
    border-radius: 10px;
  }
  .timer-fill.warning {
    background: linear-gradient(90deg, #f38181, #fce38a);
    animation: pulse 0.5s infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.7; }
  }

  /* Game area */
  .game-area {
    background: rgba(255, 255, 255, 0.95);
    border-radius: 30px;
    padding: 30px;
    box-shadow: 0 15px 40px rgba(0,0,0,0.3);
    border: 5px solid #FFD700;
    animation: slideInUp 0.8s;
  }
  @keyframes slideInUp {
    from { transform: translateY(50px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }

  /* Mission type */
  .mission-badge {
    display: inline-block;
    padding: 10px 25px;
    border-radius: 50px;
    font-size: 1.2em;
    font-weight: bold;
    margin-bottom: 20px;
    animation: wiggle 2s infinite;
  }
  @keyframes wiggle {
    0%, 100% { transform: rotate(-2deg); }
    50% { transform: rotate(2deg); }
  }
  .mission-badge.gate {
    background: linear-gradient(135deg, #a8edea, #fed6e3);
    color: #667eea;
  }
  .mission-badge.coin {
    background: linear-gradient(135deg, #ffd89b, #f7971e);
    color: #fff;
  }
  .mission-badge.monster {
    background: linear-gradient(135deg, #ff6b6b, #ee5a6f);
    color: #fff;
  }

  /* Character */
  .character {
    font-size: 4em;
    text-align: center;
    margin: 20px 0;
    animation: bounce 2s infinite;
  }
  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-20px); }
  }
  .character.attack {
    animation: attack 0.5s;
  }
  @keyframes attack {
    0% { transform: translateX(0); }
    25% { transform: translateX(-30px) rotate(-10deg); }
    75% { transform: translateX(30px) rotate(10deg); }
    100% { transform: translateX(0); }
  }

  /* Question */
  .question-box {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    padding: 25px;
    border-radius: 20px;
    margin: 20px 0;
    color: #fff;
    box-shadow: 0 8px 20px rgba(102, 126, 234, 0.4);
  }
  .question-label {
    font-size: 1.1em;
    margin-bottom: 15px;
    opacity: 0.9;
  }
  .question-text {
    font-size: 1.8em;
    font-weight: bold;
    text-align: center;
    padding: 20px;
    background: rgba(255,255,255,0.2);
    border-radius: 15px;
    font-family: 'Courier New', monospace;
  }

  /* Options */
  .options {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
    margin: 25px 0;
  }
  .option-btn {
    padding: 20px;
    font-size: 1.3em;
    border: 4px solid #667eea;
    border-radius: 20px;
    background: linear-gradient(135deg, #fff 0%, #f0f0f0 100%);
    cursor: pointer;
    transition: all 0.3s;
    font-weight: bold;
    color: #333;
    position: relative;
    overflow: hidden;
  }
  .option-btn:hover {
    transform: translateY(-5px) scale(1.02);
    box-shadow: 0 10px 25px rgba(102, 126, 234, 0.4);
    border-color: #FFD700;
  }
  .option-btn.correct {
    background: linear-gradient(135deg, #84fab0, #8fd3f4);
    border-color: #4ecdc4;
    animation: correctPulse 0.5s;
  }
  @keyframes correctPulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.1); }
  }
  .option-btn.wrong {
    background: linear-gradient(135deg, #ff9a9e, #fecfef);
    border-color: #ff6b6b;
    animation: shake 0.5s;
  }
  @keyframes shake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-10px); }
    75% { transform: translateX(10px); }
  }
  .option-btn:disabled {
    cursor: not-allowed;
    opacity: 0.6;
  }

  /* Buttons */
  .btn {
    padding: 15px 35px;
    font-size: 1.2em;
    border: none;
    border-radius: 50px;
    cursor: pointer;
    font-weight: bold;
    transition: all 0.3s;
    margin: 5px;
    box-shadow: 0 5px 15px rgba(0,0,0,0.2);
  }
  .btn-hint {
    background: linear-gradient(135deg, #a8edea, #fed6e3);
    color: #667eea;
  }
  .btn-hint:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(102, 126, 234, 0.4);
  }
  .btn-primary {
    background: linear-gradient(135deg, #667eea, #764ba2);
    color: #fff;
  }
  .btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(102, 126, 234, 0.5);
  }

  /* Feedback */
  .feedback {
    margin-top: 20px;
    padding: 20px;
    border-radius: 20px;
    animation: fadeIn 0.5s;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .feedback.correct {
    background: linear-gradient(135deg, #84fab0, #8fd3f4);
    border: 3px solid #4ecdc4;
  }
  .feedback.wrong {
    background: linear-gradient(135deg, #ff9a9e, #fecfef);
    border: 3px solid #ff6b6b;
  }
  .feedback-title {
    font-size: 1.5em;
    font-weight: bold;
    margin-bottom: 10px;
  }
  .solution {
    margin-top: 15px;
    padding: 15px;
    background: rgba(255,255,255,0.9);
    border-radius: 15px;
    font-size: 1.1em;
    line-height: 1.6;
  }

  /* Modal */
  .modal {
    display: none;
    position: fixed;
    top: 0; left: 0;
    width: 100%; height: 100%;
    background: rgba(0,0,0,0.8);
    z-index: 1000;
    justify-content: center;
    align-items: center;
  }
  .modal.show { display: flex; }
  .modal-content {
    background: linear-gradient(135deg, #fff 0%, #f0f0f0 100%);
    padding: 40px;
    border-radius: 30px;
    text-align: center;
    max-width: 550px;
    border: 6px solid #FFD700;
    box-shadow: 0 0 60px rgba(255, 215, 0, 0.6);
    animation: popIn 0.6s;
  }
  @keyframes popIn {
    0% { transform: scale(0) rotate(-10deg); }
    70% { transform: scale(1.1) rotate(5deg); }
    100% { transform: scale(1) rotate(0); }
  }
  .modal-emoji {
    font-size: 5em;
    margin: 20px 0;
    animation: bounce 1s infinite;
  }
  .modal-title {
    font-size: 2.5em;
    margin-bottom: 20px;
    background: linear-gradient(45deg, #667eea, #764ba2);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .modal-text {
    font-size: 1.3em;
    margin: 20px 0;
    line-height: 1.6;
    color: #555;
  }

  /* Confetti */
  .confetti {
    position: fixed;
    width: 10px;
    height: 10px;
    background: #f00;
    position: absolute;
    animation: confettiFall 3s linear;
    z-index: 999;
  }
  @keyframes confettiFall {
    to { transform: translateY(100vh) rotate(720deg); }
  }

  /* Start screen */
  .start-screen {
    text-align: center;
    padding: 40px 20px;
  }
  .start-screen h2 {
    font-size: 2.5em;
    color: #667eea;
    margin-bottom: 20px;
  }
  .start-screen p {
    font-size: 1.2em;
    margin: 15px 0;
    color: #555;
    line-height: 1.6;
  }
  .difficulty-select {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin: 30px 0;
    flex-wrap: wrap;
  }
  .difficulty-btn {
    padding: 20px 40px;
    font-size: 1.3em;
    border: 4px solid;
    border-radius: 20px;
    cursor: pointer;
    transition: all 0.3s;
    font-weight: bold;
  }
  .difficulty-btn.easy {
    background: linear-gradient(135deg, #84fab0, #8fd3f4);
    border-color: #4ecdc4;
    color: #2c7873;
  }
  .difficulty-btn.medium {
    background: linear-gradient(135deg, #ffd89b, #f7971e);
    border-color: #f39c12;
    color: #fff;
  }
  .difficulty-btn.hard {
    background: linear-gradient(135deg, #ff6b6b, #ee5a6f);
    border-color: #e74c3c;
    color: #fff;
  }
  .difficulty-btn:hover {
    transform: translateY(-5px) scale(1.05);
    box-shadow: 0 10px 30px rgba(0,0,0,0.3);
  }

  /* Music toggle */
  .music-toggle {
    position: fixed;
    top: 20px;
    right: 20px;
    background: rgba(255,255,255,0.9);
    border: 3px solid #FFD700;
    border-radius: 50%;
    width: 60px;
    height: 60px;
    font-size: 1.5em;
    cursor: pointer;
    z-index: 100;
    transition: all 0.3s;
  }
  .music-toggle:hover {
    transform: scale(1.1) rotate(15deg);
  }

  .hidden { display: none; }

  /* Progress path */
  .progress-path {
    display: flex;
    justify-content: space-between;
    margin: 20px 0;
    padding: 15px;
    background: rgba(255,255,255,0.3);
    border-radius: 20px;
  }
  .progress-node {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5em;
    background: rgba(255,255,255,0.5);
    border: 3px solid #fff;
    transition: all 0.3s;
  }
  .progress-node.completed {
    background: linear-gradient(135deg, #84fab0, #8fd3f4);
    transform: scale(1.1);
  }
  .progress-node.current {
    background: linear-gradient(135deg, #ffd89b, #f7971e);
    animation: pulse 1s infinite;
    transform: scale(1.2);
  }

  @media (max-width: 600px) {
    .options { grid-template-columns: 1fr; }
    .header h1 { font-size: 2em; }
    .question-text { font-size: 1.3em; }
  }
</style>
</head>
<body>

<button class="music-toggle" id="musicToggle" onclick="toggleMusic()">🎵</button>

<div id="clouds"></div>
<div id="floatingElements"></div>

<div class="container">
  <div class="header">
    <h1>🎮 MATH ADVENTURE</h1>
    <p>Petualangan Matematika Kelas X</p>
  </div>

  <!-- Start Screen -->
  <div id="startScreen" class="start-screen game-area">
    <div style="font-size: 5em; margin: 20px 0;">🧙‍♂️</div>
    <h2>Selamat Datang, Petualang!</h2>
    <p>Jelajahi dunia fantasi dan kalahkan monster dengan kekuatan matematika!</p>
    <p>Selesaikan soal <b>Eksponen</b>, <b>Bentuk Akar</b>, dan <b>Logaritma</b> untuk membuka gerbang, mengumpulkan koin, dan mengalahkan monster!</p>
    
    <div class="difficulty-select">
      <button class="difficulty-btn easy" onclick="startGame('easy')">
        😊<br>MUDAH<br><small>Eksponen</small>
      </button>
      <button class="difficulty-btn medium" onclick="startGame('medium')">
        🤔<br>SEDANG<br><small>Bentuk Akar</small>
      </button>
      <button class="difficulty-btn hard" onclick="startGame('hard')">
        😤<br>SULIT<br><small>Logaritma</small>
      </button>
    </div>

    <p style="font-size: 0.9em; color: #888;">
      ⏱️ Waktu terbatas per soal | 💡 Petunjuk tersedia | 🏆 Kumpulkan skor tertinggi!
    </p>
  </div>

  <!-- Game Screen -->
  <div id="gameScreen" class="hidden">
    <div class="stats-bar">
      <div class="stat-item">
        <div class="icon">🏆</div>
        <div class="label">SKOR</div>
        <div class="value score" id="score">0</div>
      </div>
      <div class="stat-item">
        <div class="icon">🪙</div>
        <div class="label">KOIN</div>
        <div class="value" id="coins">0</div>
      </div>
      <div class="stat-item">
        <div class="icon">📊</div>
        <div class="label">LEVEL</div>
        <div class="value level" id="level">1</div>
      </div>
      <div class="stat-item">
        <div class="icon">⏱️</div>
        <div class="label">WAKTU</div>
        <div class="value timer" id="timerDisplay">30</div>
      </div>
    </div>

    <div class="timer-bar">
      <div class="timer-fill" id="timerFill"></div>
    </div>

    <div class="progress-path" id="progressPath"></div>

    <div class="game-area" id="gameArea">
      <!-- Game content loaded here -->
    </div>
  </div>
</div>

<!-- Victory Modal -->
<div class="modal" id="victoryModal">
  <div class="modal-content">
    <div class="modal-emoji" id="modalEmoji">🏆</div>
    <h2 class="modal-title" id="modalTitle">KEMENANGAN!</h2>
    <p class="modal-text" id="modalText"></p>
    <button class="btn btn-primary" onclick="nextLevel()" id="nextBtn">LANJUT PETUALANGAN ➡️</button>
    <br>
    <button class="btn btn-hint" onclick="restartGame()" style="margin-top: 10px;">🔄 MAIN LAGI</button>
  </div>
</div>

<script>
// ==================== AUDIO SYSTEM ====================
let audioContext = null;
let musicPlaying = false;
let musicInterval = null;

function initAudio() {
  if (!audioContext) {
    audioContext = new (window.AudioContext || window.webkitAudioContext)();
  }
}

function playNote(frequency, duration, type = 'sine', volume = 0.3) {
  if (!audioContext) return;
  const oscillator = audioContext.createOscillator();
  const gainNode = audioContext.createGain();
  
  oscillator.connect(gainNode);
  gainNode.connect(audioContext.destination);
  
  oscillator.frequency.value = frequency;
  oscillator.type = type;
  
  gainNode.gain.setValueAtTime(volume, audioContext.currentTime);
  gainNode.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + duration);
  
  oscillator.start(audioContext.currentTime);
  oscillator.stop(audioContext.currentTime + duration);
}

function playCorrectSound() {
  playNote(523.25, 0.15, 'sine', 0.3); // C5
  setTimeout(() => playNote(659.25, 0.15, 'sine', 0.3), 100); // E5
  setTimeout(() => playNote(783.99, 0.3, 'sine', 0.3), 200); // G5
}

function playWrongSound() {
  playNote(200, 0.3, 'sawtooth', 0.2);
  setTimeout(() => playNote(150, 0.4, 'sawtooth', 0.2), 150);
}

function playCoinSound() {
  playNote(987.77, 0.1, 'square', 0.2); // B5
  setTimeout(() => playNote(1318.51, 0.2, 'square', 0.2), 50); // E6
}

function playVictorySound() {
  const notes = [523.25, 659.25, 783.99, 1046.50]; // C5, E5, G5, C6
  notes.forEach((note, i) => {
    setTimeout(() => playNote(note, 0.3, 'sine', 0.3), i * 150);
  });
}

function startBackgroundMusic() {
  if (musicPlaying) return;
  musicPlaying = true;
  document.getElementById('musicToggle').textContent = '🎵';
  
  const melody = [
    { note: 523.25, duration: 0.3 }, // C5
    { note: 587.33, duration: 0.3 }, // D5
    { note: 659.25, duration: 0.3 }, // E5
    { note: 523.25, duration: 0.3 }, // C5
    { note: 659.25, duration: 0.3 }, // E5
    { note: 783.99, duration: 0.6 }, // G5
    { note: 659.25, duration: 0.3 }, // E5
    { note: 523.25, duration: 0.6 }, // C5
  ];
  
  let index = 0;
  musicInterval = setInterval(() => {
    if (musicPlaying) {
      const { note, duration } = melody[index];
      playNote(note, duration, 'sine', 0.1);
      index = (index + 1) % melody.length;
    }
  }, 350);
}

function stopBackgroundMusic() {
  musicPlaying = false;
  document.getElementById('musicToggle').textContent = '🔇';
  if (musicInterval) {
    clearInterval(musicInterval);
    musicInterval = null;
  }
}

function toggleMusic() {
  initAudio();
  if (musicPlaying) {
    stopBackgroundMusic();
  } else {
    startBackgroundMusic();
  }
}

// ==================== GAME DATA ====================
const gameData = {
  easy: {
    name: "MUDAH",
    topic: "Eksponen",
    timeLimit: 30,
    questions: [
      {
        mission: "gate",
        question: "2³ = ?",
        options: ["6", "8", "9", "16"],
        correct: 1,
        hint: "2³ berarti 2 dikalikan sebanyak 3 kali",
        solution: "2³ = 2 × 2 × 2 = 8\n\nEksponen menunjukkan perkalian berulang"
      },
      {
        mission: "coin",
        question: "5² × 5³ = 5^?",
        options: ["5", "6", "8", "15"],
        correct: 1,
        hint: "Jika basis sama dikalikan, pangkatnya dijumlahkan",
        solution: "5² × 5³ = 5^(2+3) = 5⁵\n\nSifat: aᵐ × aⁿ = aᵐ⁺ⁿ"
      },
      {
        mission: "monster",
        question: "3⁴ ÷ 3² = ?",
        options: ["3", "9", "27", "81"],
        correct: 1,
        hint: "Jika basis sama dibagi, pangkatnya dikurangkan",
        solution: "3⁴ ÷ 3² = 3^(4-2) = 3² = 9\n\nSifat: aᵐ ÷ aⁿ = aᵐ⁻ⁿ"
      }
    ]
  },
  medium: {
    name: "SEDANG",
    topic: "Bentuk Akar",
    timeLimit: 40,
    questions: [
      {
        mission: "gate",
        question: "√48 = ?",
        options: ["2√12", "4√3", "6√2", "3√6"],
        correct: 1,
        hint: "Faktorkan 48 = 16 × 3, lalu keluarkan faktor kuadrat sempurna",
        solution: "√48 = √(16 × 3) = √16 × √3 = 4√3\n\nKeluar kan faktor kuadrat sempurna dari akar"
      },
      {
        mission: "coin",
        question: "√12 + √27 = ?",
        options: ["5√3", "3√5", "4√6", "6√3"],
        correct: 0,
        hint: "Sederhanakan masing-masing akar terlebih dahulu",
        solution: "√12 + √27 = √(4×3) + √(9×3)\n= 2√3 + 3√3 = 5√3\n\nAkar sejenis dapat dijumlahkan"
      },
      {
        mission: "monster",
        question: "√8 × √18 = ?",
        options: ["12", "16", "24", "36"],
        correct: 0,
        hint: "Kalikan isi akar: √a × √b = √(a×b)",
        solution: "√8 × √18 = √(8×18) = √144 = 12\n\nAtau: √8 × √18 = 2√2 × 3√2 = 6×2 = 12"
      }
    ]
  },
  hard: {
    name: "SULIT",
    topic: "Logaritma",
    timeLimit: 50,
    questions: [
      {
        mission: "gate",
        question: "²log 8 = ?",
        options: ["2", "3", "4", "8"],
        correct: 1,
        hint: "²log 8 berarti 2 pangkat berapa yang hasilnya 8?",
        solution: "²log 8 = ³\nKarena 2³ = 8\n\nLogaritma adalah kebalikan dari eksponen"
      },
      {
        mission: "coin",
        question: "³log 27 + ³log 9 = ?",
        options: ["3", "4", "5", "6"],
        correct: 2,
        hint: "Gunakan sifat: ᵃlog b + ᵃlog c = ᵃlog(b×c)",
        solution: "³log 27 + ³log 9 = ³log(27×9)\n= ³log 243 = 5\n\nKarena 3⁵ = 243\n\nAtau: 3 + 2 = 5"
      },
      {
        mission: "monster",
        question: "²log 16 - ²log 4 = ?",
        options: ["1", "2", "3", "4"],
        correct: 1,
        hint: "Gunakan sifat: ᵃlog b - ᵃlog c = ᵃlog(b÷c)",
        solution: "²log 16 - ²log 4 = ²log(16÷4)\n= ²log 4 = 2\n\nKarena 2² = 4\n\nAtau: 4 - 2 = 2"
      }
    ]
  }
};

// ==================== GAME STATE ====================
let currentDifficulty = null;
let currentQuestionIndex = 0;
let score = 0;
let coins = 0;
let timeLeft = 0;
let timerInterval = null;
let answered = false;
let hintUsed = false;

// ==================== VISUAL EFFECTS ====================
function createClouds() {
  const container = document.getElementById('clouds');
  for (let i = 0; i < 5; i++) {
    const cloud = document.createElement('div');
    cloud.className = 'cloud';
    cloud.style.width = (100 + Math.random() * 100) + 'px';
    cloud.style.height = (40 + Math.random() * 30) + 'px';
    cloud.style.top = (Math.random() * 50) + '%';
    cloud.style.left = '-200px';
    cloud.style.animationDelay = (i * 6) + 's';
    cloud.style.animationDuration = (25 + Math.random() * 15) + 's';
    container.appendChild(cloud);
  }
}

function createFloatingElements() {
  const container = document.getElementById('floatingElements');
  const elements = ['⭐', '✨', '💫', '🌟', '🎈', '🦋', '🌸'];
  for (let i = 0; i < 15; i++) {
    const el = document.createElement('div');
    el.className = 'floating-element';
    el.textContent = elements[Math.floor(Math.random() * elements.length)];
    el.style.left = Math.random() * 100 + '%';
    el.style.animationDelay = Math.random() * 10 + 's';
    el.style.animationDuration = (8 + Math.random() * 8) + 's';
    container.appendChild(el);
  }
}

function createConfetti() {
  const colors = ['#ff6b6b', '#4ecdc4', '#ffd93d', '#6bcf7f', '#a29bfe', '#fd79a8'];
  for (let i = 0; i < 50; i++) {
    setTimeout(() => {
      const confetti = document.createElement('div');
      confetti.className = 'confetti';
      confetti.style.left = Math.random() * 100 + '%';
      confetti.style.top = '-10px';
      confetti.style.background = colors[Math.floor(Math.random() * colors.length)];
      confetti.style.animationDelay = Math.random() * 0.5 + 's';
      document.body.appendChild(confetti);
      setTimeout(() => confetti.remove(), 3000);
    }, i * 50);
  }
}

// ==================== GAME LOGIC ====================
function startGame(difficulty) {
  initAudio();
  if (!musicPlaying) startBackgroundMusic();
  
  currentDifficulty = difficulty;
  currentQuestionIndex = 0;
  score = 0;
  coins = 0;
  
  document.getElementById('startScreen').classList.add('hidden');
  document.getElementById('gameScreen').classList.remove('hidden');
  
  loadQuestion();
}

function loadQuestion() {
  const data = gameData[currentDifficulty];
  const question = data.questions[currentQuestionIndex];
  answered = false;
  hintUsed = false;
  
  updateStats();
  updateProgressPath();
  
  const missionType = question.mission;
  const missionLabels = {
    gate: { icon: '🚪', text: 'BUKA GERBANG', class: 'gate' },
    coin: { icon: '🪙', text: 'KUMPULKAN KOIN', class: 'coin' },
    monster: { icon: '👹', text: 'KALAHKAN MONSTER', class: 'monster' }
  };
  
  const characters = {
    gate: '🧙‍♂️',
    coin: '💰',
    monster: '⚔️'
  };
  
  const mission = missionLabels[missionType];
  
  document.getElementById('gameArea').innerHTML = `
    <div style="text-align: center;">
      <span class="mission-badge ${mission.class}">${mission.icon} ${mission.text}</span>
    </div>
    
    <div class="character" id="character">${characters[missionType]}</div>
    
    <div class="question-box">
      <div class="question-label">📐 ${data.topic} - Level ${data.name}</div>
      <div class="question-text">${question.question}</div>
    </div>
    
    <div class="options">
      ${question.options.map((opt, i) => `
        <button class="option-btn" onclick="selectAnswer(${i})" id="option${i}">
          ${String.fromCharCode(65 + i)}. ${opt}
        </button>
      `).join('')}
    </div>
    
    <div style="text-align: center;">
      <button class="btn btn-hint" onclick="showHint()" id="hintBtn">💡 Petunjuk</button>
    </div>
    
    <div id="feedback"></div>
  `;
  
  startTimer(data.timeLimit);
}

function startTimer(seconds) {
  timeLeft = seconds;
  updateTimerDisplay();
  
  if (timerInterval) clearInterval(timerInterval);
  
  timerInterval = setInterval(() => {
    timeLeft--;
    updateTimerDisplay();
    
    if (timeLeft <= 0) {
      clearInterval(timerInterval);
      if (!answered) {
        timeUp();
      }
    }
  }, 1000);
}

function updateTimerDisplay() {
  document.getElementById('timerDisplay').textContent = timeLeft;
  const fill = document.getElementById('timerFill');
  const data = gameData[currentDifficulty];
  const percentage = (timeLeft / data.timeLimit) * 100;
  fill.style.width = percentage + '%';
  
  if (percentage < 30) {
    fill.classList.add('warning');
  } else {
    fill.classList.remove('warning');
  }
}

function updateStats() {
  document.getElementById('score').textContent = score;
  document.getElementById('coins').textContent = coins;
  document.getElementById('level').textContent = currentQuestionIndex + 1;
}

function updateProgressPath() {
  const data = gameData[currentDifficulty];
  const path = document.getElementById('progressPath');
  
  path.innerHTML = data.questions.map((q, i) => {
    let className = 'progress-node';
    if (i < currentQuestionIndex) className += ' completed';
    if (i === currentQuestionIndex) className += ' current';
    
    const icons = { gate: '🚪', coin: '🪙', monster: '👹' };
    return `<div class="${className}">${icons[q.mission]}</div>`;
  }).join('<div style="flex:1; height:4px; background:#fff; align-self:center; margin:0 5px;"></div>');
}

function selectAnswer(index) {
  if (answered) return;
  answered = true;
  clearInterval(timerInterval);
  
  const data = gameData[currentDifficulty];
  const question = data.questions[currentQuestionIndex];
  const isCorrect = index === question.correct;
  
  // Disable all options
  question.options.forEach((_, i) => {
    document.getElementById(`option${i}`).disabled = true;
  });
  
  // Mark correct/wrong
  document.getElementById(`option${question.correct}`).classList.add('correct');
  if (!isCorrect) {
    document.getElementById(`option${index}`).classList.add('wrong');
  }
  
  // Character attack animation
  document.getElementById('character').classList.add('attack');
  
  if (isCorrect) {
    handleCorrect(question);
  } else {
    handleWrong(question);
  }
}

function handleCorrect(question) {
  playCorrectSound();
  
  // Calculate score based on time and difficulty
  const baseScore = currentDifficulty === 'easy' ? 100 : currentDifficulty === 'medium' ? 150 : 200;
  const timeBonus = Math.floor(timeLeft * 2);
  const hintPenalty = hintUsed ? 20 : 0;
  const earnedScore = baseScore + timeBonus - hintPenalty;
  
  score += earnedScore;
  
  // Coin collection
  if (question.mission === 'coin') {
    coins += 10;
    playCoinSound();
  } else {
    coins += 5;
  }
  
  updateStats();
  
  const feedback = document.getElementById('feedback');
  feedback.innerHTML = `
    <div class="feedback correct">
      <div class="feedback-title">✅ BENAR! +${earnedScore} Poin</div>
      <p>🎉 ${question.mission === 'gate' ? 'Gerbang terbuka!' : question.mission === 'coin' ? 'Koin terkumpul!' : 'Monster dikalahkan!'}</p>
      <p style="font-size: 0.9em; margin-top: 10px;">
        Base: ${baseScore} | Bonus Waktu: +${timeBonus} ${hintUsed ? '| Petunjuk: -20' : ''}
      </p>
      <div class="solution">
        <b>📖 Pembahasan:</b><br>
        ${question.solution.replace(/\n/g, '<br>')}
      </div>
    </div>
  `;
  
  setTimeout(() => {
    if (currentQuestionIndex < gameData[currentDifficulty].questions.length - 1) {
      showLevelComplete(false);
    } else {
      showLevelComplete(true);
    }
  }, 3500);
}

function handleWrong(question) {
  playWrongSound();
  
  const feedback = document.getElementById('feedback');
  feedback.innerHTML = `
    <div class="feedback wrong">
      <div class="feedback-title">❌ Kurang Tepat!</div>
      <p>Jangan menyerah, coba lagi di soal berikutnya!</p>
      <div class="solution">
        <b>📖 Pembahasan:</b><br>
        ${question.solution.replace(/\n/g, '<br>')}
      </div>
    </div>
  `;
  
  setTimeout(() => {
    if (currentQuestionIndex < gameData[currentDifficulty].questions.length - 1) {
      currentQuestionIndex++;
      loadQuestion();
    } else {
      showLevelComplete(true);
    }
  }, 3500);
}

function timeUp() {
  answered = true;
  playWrongSound();
  
  const data = gameData[currentDifficulty];
  const question = data.questions[currentQuestionIndex];
  
  document.getElementById(`option${question.correct}`).classList.add('correct');
  
  const feedback = document.getElementById('feedback');
  feedback.innerHTML = `
    <div class="feedback wrong">
      <div class="feedback-title">⏰ Waktu Habis!</div>
      <p>Terlambat! Jawaban yang benar ditandai hijau.</p>
      <div class="solution">
        <b>📖 Pembahasan:</b><br>
        ${question.solution.replace(/\n/g, '<br>')}
      </div>
    </div>
  `;
  
  setTimeout(() => {
    if (currentQuestionIndex < gameData[currentDifficulty].questions.length - 1) {
      currentQuestionIndex++;
      loadQuestion();
    } else {
      showLevelComplete(true);
    }
  }, 3500);
}

function showHint() {
  if (hintUsed) return;
  hintUsed = true;
  
  const question = gameData[currentDifficulty].questions[currentQuestionIndex];
  const feedback = document.getElementById('feedback');
  
  feedback.innerHTML = `
    <div class="feedback" style="background: linear-gradient(135deg, #a8edea, #fed6e3); border: 3px solid #667eea;">
      <div class="feedback-title" style="color: #667eea;">💡 Petunjuk:</div>
      <p>${question.hint}</p>
      <p style="font-size: 0.9em; margin-top: 10px; color: #888;">(Menggunakan petunjuk mengurangi 20 poin)</p>
    </div>
  `;
  
  document.getElementById('hintBtn').disabled = true;
}

function showLevelComplete(isFinal) {
  clearInterval(timerInterval);
  
  const data = gameData[currentDifficulty];
  const modal = document.getElementById('victoryModal');
  const emoji = document.getElementById('modalEmoji');
  const title = document.getElementById('modalTitle');
  const text = document.getElementById('modalText');
  const nextBtn = document.getElementById('nextBtn');
  
  if (isFinal) {
    playVictorySound();
    createConfetti();
    
    emoji.textContent = '🏆';
    title.textContent = 'PETUALANGAN SELESAI!';
    text.innerHTML = `
      Kamu telah menyelesaikan semua tantangan <b>${data.topic}</b>!<br><br>
      <b>🏆 Skor Akhir: ${score}</b><br>
      <b>🪙 Koin Terkumpul: ${coins}</b><br><br>
      ${score >= 500 ? 'Luar biasa! Kamu Master Matematika! 🌟' : 
        score >= 300 ? 'Hebat! Terus berlatih! 💪' : 
        'Ayo coba lagi untuk skor lebih tinggi! 🚀'}
    `;
    nextBtn.textContent = '🏠 KEMENU UTAMA';
    nextBtn.onclick = restartGame;
  } else {
    playCoinSound();
    
    emoji.textContent = '⭐';
    title.textContent = 'LEVEL SELESAI!';
    text.innerHTML = `
      Tantangan ${currentQuestionIndex + 1} berhasil!<br><br>
      <b>Skor saat ini: ${score}</b><br>
      <b>Koin: ${coins}</b><br><br>
      Siap untuk tantangan berikutnya?
    `;
    nextBtn.textContent = 'LANJUT PETUALANGAN ➡️';
    nextBtn.onclick = nextLevel;
  }
  
  modal.classList.add('show');
}

function nextLevel() {
  document.getElementById('victoryModal').classList.remove('show');
  currentQuestionIndex++;
  loadQuestion();
}

function restartGame() {
  document.getElementById('victoryModal').classList.remove('show');
  document.getElementById('gameScreen').classList.add('hidden');
  document.getElementById('startScreen').classList.remove('hidden');
  
  clearInterval(timerInterval);
  currentDifficulty = null;
  currentQuestionIndex = 0;
  score = 0;
  coins = 0;
}

// ==================== INITIALIZE ====================
createClouds();
createFloatingElements();

// Auto-start music on first interaction
document.addEventListener('click', function initOnClick() {
  initAudio();
  if (!musicPlaying) {
    startBackgroundMusic();
  }
  document.removeEventListener('click', initOnClick);
}, { once: true });
</script>

